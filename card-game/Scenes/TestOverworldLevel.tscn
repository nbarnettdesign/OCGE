display_name = "BatKid"
talk_lines = Array[String](["I AM THE NIGHT!", "I AM THE DARKNESS!", "I AM....requesting a duel, if that wasnt clear", "player: are you old enough to be out here by yourself?", "What are you? a cop?"])

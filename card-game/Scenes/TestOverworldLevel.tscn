y_sort_enabled = true
position = Vector2(-19, 320)
npc_id = "zoo_keeper"
display_name = "Deev Urvin"
talk_lines = Array[String](["Crikey! you must be here for a card battle!", "player: is that a crocodile!?!", "yeah nah, dont even worry about that"])
